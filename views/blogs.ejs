<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partials/head.ejs') %>
    <title>Read Blogs - Digital Dynamics Review</title>
    <style>
        /* Blogs Section */
        .blogs-section {
            margin: 80px 0;
        }

        .blogs-header {
            text-align: center;
            margin-bottom: 60px;
            animation: fadeInDown 0.6s ease-out;
        }

        .blogs-header h1 {
            font-size: 2.8rem;
            font-weight: 700;
            margin-bottom: 15px;
            color: var(--gray-800);
        }

        .blogs-header p {
            font-size: 1.1rem;
            color: var(--gray-500);
        }

        .card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 28px rgba(0, 0, 0, 0.12);
            border-color: var(--primary-blue);
        }

        .card-title {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .blog-grid {
            gap: 1.5rem;
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 80px 20px;
        }

        .empty-state-icon {
            font-size: 5rem;
            color: var(--gray-300);
            margin-bottom: 20px;
        }

        .empty-state h3 {
            font-size: 1.8rem;
            color: var(--gray-500);
            margin-bottom: 15px;
        }

        .empty-state p {
            color: var(--gray-400);
            font-size: 1.1rem;
            margin-bottom: 30px;
        }

        /* Review Card Staggered Animation */
        .blog-grid .col:nth-child(1) .card { animation-delay: 0s; }
        .blog-grid .col:nth-child(2) .card { animation-delay: 0.1s; }
        .blog-grid .col:nth-child(3) .card { animation-delay: 0.2s; }
        .blog-grid .col:nth-child(4) .card { animation-delay: 0.3s; }
        .blog-grid .col:nth-child(5) .card { animation-delay: 0.4s; }
        .blog-grid .col:nth-child(6) .card { animation-delay: 0.5s; }
        .blog-grid .col:nth-child(n+7) .card { animation-delay: 0.6s; }

        /* Browse All Button */
        .browse-all-btn {
            text-align: center;
            margin-top: 60px;
            padding-bottom: 60px;
        }
    </style>
</head>

<body>
    <%- include('./partials/nav.ejs') %>

    <!-- Blogs Header -->
    <div class="container blogs-section">
        <div class="blogs-header">
            <h1>📚 Explore Our Reviews</h1>
            <p>Discover insightful digital product reviews and tech insights</p>
        </div>

        <% if (blogs.length === 0) { %>
            <div class="empty-state">
                <div class="empty-state-icon">📝</div>
                <h3>No Reviews Published Yet</h3>
                <p>Check back soon for our latest digital reviews and insights!</p>
                <% if (user) { %>
                    <a href="/blog/add-new" class="btn btn-primary btn-lg">Write a Review</a>
                <% } %>
            </div>
        <% } else { %>
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 blog-grid">
                <% blogs.forEach((blog, index) => { %>
                    <div class="col d-flex">
                        <div class="card flex-fill h-100 animate-scale-in">
                            <img src="<%= blog.coverImageURL %>" class="card-img-top" alt="Review cover image">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title" title="<%= blog.title %>"><%= blog.title %></h5>
                                <small class="text-muted mb-3">By <%= blog.createdBy?.fullName || 'Anonymous' %></small>
                                <a href="/blog/<%= blog._id %>" class="btn btn-outline-primary mt-auto">Read Review →</a>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </div>

    <!-- Footer Spacing -->
    <div style="margin-bottom: 60px;"></div>

    <%- include('./partials/scripts.ejs') %>
</body>

</html>
