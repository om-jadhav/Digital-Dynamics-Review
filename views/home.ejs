<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partials/head.ejs') %>
    <title>Digital Dynamics Review - Expert Product & Tech Reviews</title>
    <style>
        /* Hero Section */
        .hero-section {
            background: linear-gradient(135deg, var(--primary-blue) 0%, var(--primary-blue-dark) 100%);
            color: var(--white);
            padding: 100px 0;
            margin-bottom: 60px;
            border-radius: 15px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .hero-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 600"><defs><pattern id="pattern" x="0" y="0" width="100" height="100" patternUnits="userSpaceOnUse"><circle cx="50" cy="50" r="1" fill="rgba(255,255,255,0.1)"/></pattern></defs><rect fill="%230d6efd" width="1200" height="600"/><rect fill="url(%23pattern)" width="1200" height="600"/></svg>');
            opacity: 0.3;
        }

        .hero-content {
            position: relative;
            z-index: 2;
        }

        .hero-section h1 {
            font-size: 4rem;
            font-weight: 800;
            margin-bottom: 20px;
            animation: fadeInDown 0.8s ease-out;
            letter-spacing: -2px;
        }

        .hero-section .tagline {
            font-size: 1.5rem;
            margin-bottom: 30px;
            animation: fadeInUp 0.8s ease-out 0.2s both;
            opacity: 0.95;
        }

        .hero-section p {
            font-size: 1.2rem;
            margin-bottom: 30px;
            animation: fadeInUp 0.8s ease-out 0.3s both;
            opacity: 0.9;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
        }

        .hero-buttons {
            animation: fadeInUp 0.8s ease-out 0.4s both;
        }

        .hero-buttons .btn {
            margin: 0 10px 10px;
            padding: 14px 40px;
            font-size: 1.1rem;
            font-weight: 600;
        }

        .btn-light {
            background: var(--white);
            color: var(--primary-blue);
        }

        .btn-light:hover {
            background: var(--primary-blue-light);
            color: var(--primary-blue);
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
        }

        /* About Section */
        .about-section {
            margin: 80px 0;
            padding: 50px;
            background: var(--gray-50);
            border-radius: 15px;
            animation: fadeInUp 0.8s ease-out;
        }

        .about-section h2 {
            color: var(--primary-blue);
            margin-bottom: 20px;
            font-weight: 700;
            font-size: 2.2rem;
            animation: fadeInDown 0.6s ease-out;
        }

        .about-section p {
            font-size: 1.1rem;
            color: var(--gray-600);
            line-height: 1.8;
            animation: fadeInUp 0.6s ease-out 0.2s both;
        }

        /* Why Choose Section */
        .why-choose-section {
            margin: 80px 0;
        }

        .why-choose-section h2 {
            text-align: center;
            font-weight: 700;
            font-size: 2.2rem;
            margin-bottom: 60px;
            animation: fadeInDown 0.6s ease-out;
        }

        .benefit-card {
            text-align: center;
            padding: 40px 30px;
            background: var(--white);
            border-radius: 12px;
            transition: all 0.3s ease;
            border: 1px solid var(--gray-100);
            animation: fadeInUp 0.6s ease-out;
        }

        .benefit-card:nth-child(1) { animation-delay: 0.1s; }
        .benefit-card:nth-child(2) { animation-delay: 0.2s; }
        .benefit-card:nth-child(3) { animation-delay: 0.3s; }
        .benefit-card:nth-child(4) { animation-delay: 0.4s; }

        .benefit-card:hover {
            transform: translateY(-12px);
            box-shadow: 0 12px 30px rgba(13, 110, 253, 0.15);
            border-color: var(--primary-blue);
        }

        .benefit-icon {
            font-size: 3.5rem;
            margin-bottom: 15px;
            color: var(--primary-blue);
            transition: all 0.3s ease;
        }

        .benefit-card:hover .benefit-icon {
            transform: scale(1.2) rotate(5deg);
        }

        .benefit-card h4 {
            font-weight: 600;
            margin-bottom: 15px;
            color: var(--gray-800);
            font-size: 1.3rem;
        }

        .benefit-card p {
            color: var(--gray-500);
            font-size: 0.95rem;
        }

        /* Latest Reviews Preview */
        .reviews-preview {
            margin: 80px 0;
            padding: 60px;
            background: linear-gradient(135deg, var(--gray-50) 0%, var(--white) 100%);
            border-radius: 15px;
        }

        .reviews-preview h2 {
            text-align: center;
            font-weight: 700;
            font-size: 2.2rem;
            margin-bottom: 50px;
            animation: fadeInDown 0.6s ease-out;
        }

        .review-preview-card {
            animation: fadeInUp 0.6s ease-out;
        }

        .review-preview-card:nth-child(1) { animation-delay: 0.1s; }
        .review-preview-card:nth-child(2) { animation-delay: 0.2s; }
        .review-preview-card:nth-child(3) { animation-delay: 0.3s; }

        /* CTA Section */
        .cta-section {
            background: linear-gradient(135deg, var(--primary-blue) 0%, var(--primary-blue-dark) 100%);
            color: var(--white);
            padding: 70px 50px;
            border-radius: 15px;
            text-align: center;
            margin: 80px 0;
            animation: scaleIn 0.6s ease-out;
        }

        .cta-section h3 {
            font-size: 2.5rem;
            margin-bottom: 20px;
            font-weight: 700;
        }

        .cta-section p {
            font-size: 1.2rem;
            margin-bottom: 30px;
            opacity: 0.95;
        }

        /* Stats Section */
        .stats-section {
            display: flex;
            justify-content: space-around;
            margin: 80px 0;
            flex-wrap: wrap;
            gap: 40px;
        }

        .stat-item {
            text-align: center;
            animation: fadeInUp 0.6s ease-out;
        }

        .stat-number {
            font-size: 3rem;
            font-weight: 800;
            color: var(--primary-blue);
        }

        .stat-label {
            font-size: 1.1rem;
            color: var(--gray-500);
            margin-top: 10px;
        }

        @media (max-width: 768px) {
            .hero-section h1 {
                font-size: 2.2rem;
            }

            .hero-section .tagline {
                font-size: 1.2rem;
            }

            .hero-section p {
                font-size: 1rem;
            }

            .hero-buttons .btn {
                margin: 8px 5px;
                padding: 10px 20px;
                font-size: 0.95rem;
            }

            .about-section,
            .reviews-preview {
                padding: 30px;
            }

            .cta-section {
                padding: 40px 20px;
            }

            .stats-section {
                flex-direction: column;
                gap: 30px;
            }
        }
    </style>
</head>

<body>
    <%- include('./partials/nav.ejs') %>

    <!-- Hero Section -->
    <div class="container mt-5">
        <div class="hero-section">
            <div class="hero-content">
                <h1>Digital Dynamics Review</h1>
                <p class="tagline">Your Ultimate Source for Tech & Product Insights</p>
                <p>Expert reviews, in-depth analysis, and cutting-edge insights on the latest digital products and technologies shaping our world.</p>
                <div class="hero-buttons">
                    <a href="/blogs" class="btn btn-light">📖 Read Reviews</a>
                    <% if (!user) { %>
                        <a href="/user/signup" class="btn btn-outline-light">🚀 Join Community</a>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <!-- About Section -->
    <div class="container">
        <div class="about-section">
            <h2>🎯 About Digital Dynamics Review</h2>
            <p>
                Digital Dynamics Review is a premier platform dedicated to delivering comprehensive, honest, and actionable reviews of digital products and technologies. 
                We believe in empowering consumers and professionals with knowledge to make informed decisions. Our team of expert reviewers carefully evaluates each product, 
                analyzing features, performance, pricing, and user experience to provide you with trustworthy insights. From software solutions to hardware innovations, 
                from AI tools to productivity apps – we cover it all. Join our community and stay ahead in the digital revolution!
            </p>
        </div>
    </div>

    <!-- Stats Section -->
    <div class="container">
        <div class="stats-section">
            <div class="stat-item">
                <div class="stat-number">500+</div>
                <div class="stat-label">Products Reviewed</div>
            </div>
            <div class="stat-item">
                <div class="stat-number">50K+</div>
                <div class="stat-label">Active Readers</div>
            </div>
            <div class="stat-item">
                <div class="stat-number">100%</div>
                <div class="stat-label">Honest Reviews</div>
            </div>
        </div>
    </div>

    <!-- Why Choose Section -->
    <div class="container why-choose-section">
        <h2>✨ Why Trust Us?</h2>
        <div class="row">
            <div class="col-lg-3 col-md-6">
                <div class="benefit-card">
                    <div class="benefit-icon">🔍</div>
                    <h4>In-Depth Analysis</h4>
                    <p>Comprehensive reviews that go beyond the surface, exploring every aspect of products</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="benefit-card">
                    <div class="benefit-icon">✅</div>
                    <h4>Unbiased Reviews</h4>
                    <p>100% honest opinions with pros and cons laid bare for transparency</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="benefit-card">
                    <div class="benefit-icon">📊</div>
                    <h4>Data-Driven</h4>
                    <p>Backed by thorough testing, benchmarks, and real-world usage scenarios</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="benefit-card">
                    <div class="benefit-icon">💬</div>
                    <h4>Community Engaged</h4>
                    <p>Share your opinions, discuss reviews, and engage with fellow tech enthusiasts</p>
                </div>
            </div>
        </div>
    </div>

    <!-- CTA Section -->
    <div class="container">
        <div class="cta-section">
            <h3>🚀 Start Your Review Journey</h3>
            <p>Explore hundreds of expert reviews and make better tech decisions</p>
            <a href="/blogs" class="btn btn-light btn-lg">Browse All Reviews</a>
            <% if (user) { %>
                <a href="/blog/add-new" class="btn btn-outline-light btn-lg ms-2">Write a Review</a>
            <% } %>
        </div>
    </div>

    <!-- Footer Spacing -->
    <div style="margin-bottom: 60px;"></div>

    <%- include('./partials/scripts.ejs') %>
</body>

</html>
